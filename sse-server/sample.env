# These values must be kept in sync with the values in the Config.php file
# Rename this to .env and fill in the values before running the SSE server:
SSE_SECRET=
SSE_PORT=43006
REDIS_HOST=redis
REDIS_PORT=6379

# The gamemaster: with a URL set, this server calls it in a loop, which is what makes games process
# and the background tasks run (see "The gamemaster driver" in server.js). Every site drives its own
# gamemaster, so this is that site's own URL - staging points at staging. Leave it empty only on an
# install that should not be processing games at all.
#
# Use the URL a player's browser would use, not localhost: the point of calling it over HTTP is that
# game processing stops when the site stops being reachable. GAMEMASTER_SECRET must match
# Config::$gameMasterSecret.
GAMEMASTER_URL=http://webserver/gamemaster.php
GAMEMASTER_SECRET=
# How long to wait after one run finishes before starting the next
GAMEMASTER_INTERVAL_MS=1000

# The monthly data export (see "The monthly data export" in server.js): with both set, this server
# runs scripts/exportGames.php once a month and uploads every finished game to this Hugging Face
# dataset. Only the live site should set them. The token is a fine-grained one with write access to
# the dataset alone. EXPORT_DIR defaults to data-export/ beside the webroot; EXPORT_PHP to php.
HF_TOKEN=
HF_DATASET=
